{
  "name": "Bytebot",
  "description": "Open-Source AI Desktop Agent - An AI that has its own computer to complete tasks for you",
  "version": "0.0.1",
  "type": "monorepo",
  "language": "typescript",
  "framework": ["nestjs", "nextjs", "prisma"],
  "packageManager": "npm",
  "rootDir": ".",
  "workspaces": [
    "packages/bytebot-agent",
    "packages/bytebot-ui", 
    "packages/bytebot-agent-cc",
    "packages/bytebotd",
    "packages/shared"
  ],
  "mainServices": {
    "bytebot-agent": {
      "port": 9991,
      "description": "Main AI agent service with NestJS backend",
      "startCommand": "npm run start:dev",
      "buildCommand": "npm run build",
      "testCommand": "npm run test"
    },
    "bytebot-ui": {
      "port": 9992,
      "description": "Next.js frontend interface",
      "startCommand": "npm run dev",
      "buildCommand": "npm run build"
    },
    "bytebot-desktop": {
      "port": 9990,
      "description": "Desktop environment service",
      "dockerService": true
    }
  },
  "database": {
    "type": "postgresql",
    "orm": "prisma",
    "migrations": "packages/bytebot-agent/prisma/migrations"
  },
  "docker": {
    "composeFile": "docker/docker-compose.development.yml",
    "services": ["bytebot-desktop", "bytebot-postgres"]
  },
  "environment": {
    "development": {
      "envFiles": [
        "docker/.env",
        "packages/bytebot-agent/.env",
        "packages/bytebot-ui/.env"
      ],
      "requiredVars": [
        "DATABASE_URL",
        "ANTHROPIC_API_KEY",
        "BYTEBOT_DESKTOP_BASE_URL",
        "BYTEBOT_AGENT_BASE_URL"
      ]
    }
  },
  "scripts": {
    "setup": "npm install && cd packages/bytebot-agent && npm run prisma:dev",
    "dev": "docker-compose -f docker/docker-compose.development.yml up -d && npm run start:dev --prefix packages/bytebot-agent & npm run dev --prefix packages/bytebot-ui",
    "build": "npm run build --prefix packages/bytebot-agent && npm run build --prefix packages/bytebot-ui",
    "test": "npm run test --prefix packages/bytebot-agent"
  },
  "gitignore": [
    "node_modules/",
    ".env*",
    "dist/",
    ".next/",
    "coverage/",
    "*.log"
  ],
  "documentation": {
    "readme": "README.md",
    "docs": "docs/",
    "website": "https://bytebot.ai",
    "apiDocs": "https://docs.bytebot.ai"
  },
  "ai": {
    "providers": ["anthropic", "openai"],
    "models": ["claude-3-5-sonnet", "gpt-4"],
    "capabilities": ["computer-use", "desktop-automation", "file-management"]
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/bytebot-ai/bytebot",
  "author": "Bytebot AI",
  "keywords": ["ai", "desktop-agent", "automation", "computer-use", "typescript", "nestjs"]
}