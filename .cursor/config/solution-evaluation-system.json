{
  "system_name": "智能解决方案评估和复用系统",
  "version": "1.0.0",
  "description": "自动评估现有解决方案，避免重复造轮子，确保技术时效性",
  
  "evaluation_criteria": {
    "技术时效性": {
      "权重": 25,
      "评估指标": [
        "最后更新时间",
        "社区活跃度",
        "版本更新频率",
        "安全补丁及时性",
        "技术栈现代化程度"
      ],
      "评分标准": {
        "优秀": "6个月内更新，活跃社区，现代化技术栈",
        "良好": "1年内更新，稳定社区，主流技术栈",
        "一般": "2年内更新，社区一般，技术栈较旧",
        "过时": "2年以上未更新，社区不活跃，技术栈过时"
      }
    },
    
    "成熟度评估": {
      "权重": 20,
      "评估指标": [
        "GitHub星标数",
        "Fork数量",
        "Issues处理速度",
        "文档完整性",
        "测试覆盖率"
      ],
      "评分标准": {
        "优秀": "10k+星标，活跃维护，完整文档",
        "良好": "5k+星标，稳定维护，文档齐全",
        "一般": "1k+星标，基础维护，文档基本完整",
        "不成熟": "500以下星标，维护不稳定，文档缺失"
      }
    },
    
    "复用可行性": {
      "权重": 20,
      "评估指标": [
        "代码质量",
        "架构兼容性",
        "依赖复杂度",
        "定制化难度",
        "集成成本"
      ],
      "评分标准": {
        "优秀": "高质量代码，架构兼容，低依赖，易定制",
        "良好": "代码质量好，基本兼容，依赖适中，可定制",
        "一般": "代码质量一般，需要适配，依赖较多，定制困难",
        "困难": "代码质量差，不兼容，高依赖，难以定制"
      }
    },
    
    "维护成本": {
      "权重": 15,
      "评估指标": [
        "学习成本",
        "维护难度",
        "升级成本",
        "技术支持",
        "社区支持"
      ],
      "评分标准": {
        "优秀": "学习成本低，维护简单，升级容易，支持完善",
        "良好": "学习成本适中，维护不难，升级可行，支持较好",
        "一般": "学习成本较高，维护复杂，升级困难，支持一般",
        "困难": "学习成本高，维护复杂，升级困难，支持不足"
      }
    },
    
    "业务匹配度": {
      "权重": 20,
      "评估指标": [
        "功能完整性",
        "性能要求",
        "安全要求",
        "扩展性",
        "用户体验"
      ],
      "评分标准": {
        "优秀": "功能完整，性能优秀，安全可靠，扩展性强",
        "良好": "功能基本完整，性能良好，安全可靠，可扩展",
        "一般": "功能部分缺失，性能一般，安全基本可靠",
        "不匹配": "功能缺失，性能不足，安全风险，难以扩展"
      }
    }
  },
  
  "decision_framework": {
    "复用现有方案": {
      "条件": [
        "技术时效性 >= 良好",
        "成熟度评估 >= 良好", 
        "复用可行性 >= 良好",
        "维护成本 <= 一般",
        "业务匹配度 >= 良好"
      ],
      "行动": [
        "直接复用现有方案",
        "进行必要的定制化",
        "集成到现有项目",
        "编写集成文档"
      ],
      "优势": [
        "快速交付",
        "降低风险",
        "节省开发成本",
        "利用社区支持"
      ]
    },
    
    "升级现有方案": {
      "条件": [
        "技术时效性 = 一般",
        "成熟度评估 >= 良好",
        "复用可行性 >= 一般",
        "维护成本 <= 一般",
        "业务匹配度 >= 良好"
      ],
      "行动": [
        "升级到最新版本",
        "适配新版本API",
        "解决兼容性问题",
        "更新相关文档"
      ],
      "优势": [
        "保持技术先进性",
        "获得新功能",
        "修复已知问题",
        "提升安全性"
      ]
    },
    
    "定制化开发": {
      "条件": [
        "技术时效性 >= 良好",
        "成熟度评估 >= 一般",
        "复用可行性 = 一般",
        "维护成本 <= 一般",
        "业务匹配度 = 一般"
      ],
      "行动": [
        "基于现有方案进行定制",
        "开发特定功能模块",
        "适配业务需求",
        "保持核心架构"
      ],
      "优势": [
        "满足特定需求",
        "保持技术先进性",
        "降低开发风险",
        "利用现有基础"
      ]
    },
    
    "重新开发": {
      "条件": [
        "技术时效性 <= 一般",
        "成熟度评估 <= 一般",
        "复用可行性 <= 一般",
        "维护成本 >= 一般",
        "业务匹配度 <= 一般"
      ],
      "行动": [
        "重新设计架构",
        "选择最新技术栈",
        "开发全新解决方案",
        "建立长期维护计划"
      ],
      "优势": [
        "技术栈现代化",
        "完全满足需求",
        "长期可维护",
        "技术领先优势"
      ]
    }
  },
  
  "automated_workflow": {
    "信息收集": {
      "步骤": [
        "1. 分析项目需求",
